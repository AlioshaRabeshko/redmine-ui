# Copy to .env, then set your own Redmine base URL there.
REDMINE_URL=https://redmine.example.invalid
REDMINE_API_TOKEN=
# Set these to the labels used by your Redmine automation rules.
REDMINE_CI_IN_PROGRESS_LABEL="Build: Running"
REDMINE_CI_FAILED_LABEL="Build: Failed"
# Empty token starts the isolated demo. Real writes require explicit opt-in.
REDMINE_WRITE_ENABLED=false
APP_MODE=auto
DATABASE_PATH=./data/workspace.sqlite
PORT=3000
HOST_PORT=3010
POLL_INTERVAL_SECONDS=10
